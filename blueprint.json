{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Avec Clone (dataset fake)",
    "author": "joselisou",
    "description": "Clone do painel Avec Pro em WordPress, pré-carregado com um dataset sintético (sem dados reais) para demonstração."
  },
  "landingPage": "/minha-conta/",
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "steps": [
    { "step": "login" },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/joselisou/avec",
        "ref": "main",
        "refType": "branch",
        "path": "/plugin/avec-clone"
      },
      "options": { "activate": true }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/avec-fake-dataset.xml",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/joselisou/avec/main/data/fake/avec-fake-dataset.xml"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; Avec_Clone_Importer::import_file('/wordpress/wp-content/avec-fake-dataset.xml');"
    }
  ]
}
